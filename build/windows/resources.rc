3 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     @VERSION_COMMAS@,0
PRODUCTVERSION  @VERSION_COMMAS@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Homebox Desktop"
            VALUE "FileDescription",  "Homebox Desktop"
            VALUE "FileVersion",      "@VERSION@"
            VALUE "InternalName",     "HomeboxDesktop"
            VALUE "LegalCopyright",   "AGPL-3.0. Homebox (c) the Homebox contributors."
            VALUE "OriginalFilename", "HomeboxDesktop.exe"
            VALUE "ProductName",      "Homebox Desktop"
            VALUE "ProductVersion",   "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
